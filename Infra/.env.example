# Copie para `.env` (não versionado) e ajuste. O docker-compose.yml lê estas variáveis.
# Os valores aqui são defaults de DESENVOLVIMENTO — troque em produção (ou defina no Portainer).

# PostgreSQL (storage/fila do Guará)
POSTGRES_DB=guara
POSTGRES_USER=guara
POSTGRES_PASSWORD=guara_dev

# --- Serviços OPCIONAIS (só se habilitar os blocos correspondentes no compose) ---

# Seq (painel de logs — opcional)
SEQ_ADMIN_PASSWORD=guara_dev

# Redis (opcional — só se habilitar o serviço redis)
REDIS_PASSWORD=guara_dev
