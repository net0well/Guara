<Project>

  <!-- Configurações comuns a todos os projetos (spec 033). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Enforcement de estilo entra num passo posterior (com .editorconfig afinado). -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Metadados comuns de pacote NuGet. -->
  <PropertyGroup>
    <Authors>Guará</Authors>
    <Company>Guará</Company>
    <Product>Guará</Product>
    <Copyright>Copyright © Guará</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/net0well/Guara</PackageProjectUrl>
    <RepositoryUrl>https://github.com/net0well/Guara</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>jobs;scheduler;background-jobs;hangfire;cron;queue;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <!--
    Versionamento e rastreabilidade do binário publicado.

    MinVer deriva a versão da tag git, então `v1.2.3` produz pacotes 1.2.3 sem ninguém editar
    número em arquivo nenhum. Commits depois da tag viram pré-release da PRÓXIMA versão, o que
    impede um build de trabalho de se passar por release.

    SourceLink vem no SDK desde o .NET 8 — basta publicar a URL do repositório. Com os
    símbolos em .snupkg e as fontes não rastreadas embutidas, um stack trace de produção abre
    no código exato do commit que gerou o pacote.

    Determinismo só liga no CI: no build local, ContinuousIntegrationBuild reescreve caminhos
    de fonte e atrapalha o depurador.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Assinatura de nome forte em todos os assemblies. Não é mecanismo de segurança (a
    chave viaja no repositório e qualquer um consegue reassinar): é identidade de
    binding. Entra agora porque o token da chave faz parte da identidade da assembly —
    adicionar ou remover depois de publicado quebra quem já referencia.

    A mesma chave em todos os projetos é o que faz o InternalsVisibleTo continuar
    valendo, já que assembly assinada só enxerga amiga assinada com a mesma chave.
  -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)guara.snk</AssemblyOriginatorKeyFile>
    <!-- Chave pública de guara.snk. O compilador exige que todo InternalsVisibleTo de
         uma assembly assinada nomeie a chave da amiga; sem isto, CS1726. -->
    <GuaraPublicKey></GuaraPublicKey>
  </PropertyGroup>

  <!-- Todo InternalsVisibleTo herda a chave: os projetos amigos são todos do produto,
       assinados com a mesma chave, então declará-la em cada csproj só duplicaria. -->
  <ItemDefinitionGroup>
    <InternalsVisibleTo Key="$(GuaraPublicKey)" />
  </ItemDefinitionGroup>

  <!-- Projetos de código (não testes): geram doc XML e são empacotáveis. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- Analisadores de trimming/AOT (ADR-0008): o núcleo deve ser AOT-safe. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Projetos de teste. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Itens da spec 033 que entram no passo de CI/empacotamento (exigem repo git + pipeline):
    SourceLink, símbolos (.snupkg), build determinístico (ContinuousIntegrationBuild),
    versão automática (MinVer) e Microsoft.CodeAnalysis.PublicApiAnalyzers.
  -->

</Project>
