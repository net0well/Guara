<Project>

  <!-- Configurações comuns a todos os projetos (spec 033). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Enforcement de estilo entra num passo posterior (com .editorconfig afinado). -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Metadados comuns de pacote NuGet (LGPL-3.0 — ADR-0009/spec 035). -->
  <PropertyGroup>
    <Authors>Guará</Authors>
    <Company>Guará</Company>
    <Product>Guará</Product>
    <Copyright>Copyright © Guará</Copyright>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/guara/guara</PackageProjectUrl>
    <RepositoryUrl>https://github.com/guara/guara</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>jobs;scheduler;background-jobs;hangfire;cron;queue;dotnet</PackageTags>
  </PropertyGroup>

  <!-- Projetos de código (não testes): geram doc XML e são empacotáveis. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- Analisadores de trimming/AOT (ADR-0008): o núcleo deve ser AOT-safe. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Projetos de teste. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Itens da spec 033 que entram no passo de CI/empacotamento (exigem repo git + pipeline):
    SourceLink, símbolos (.snupkg), build determinístico (ContinuousIntegrationBuild),
    versão automática (MinVer) e Microsoft.CodeAnalysis.PublicApiAnalyzers.
  -->

</Project>
