<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guara.Diagnostics</PackageId>
    <Description>Observabilidade do Guará: middlewares de logging estruturado, tracing (ActivitySource) e métricas (Meter) para o pipeline de execução — só BCL, sem sinks de terceiros.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guara.Abstractions\Guara.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Os middlewares entram no pipeline por UseGuaraDiagnostics(); os testes de ponta a
       ponta os montam à mão para verificar a ordem das etapas. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Guara.Engines.Tests" />
  </ItemGroup>

</Project>
