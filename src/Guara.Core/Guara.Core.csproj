<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guara.Core</PackageId>
    <Description>Núcleo do Guará: JobContext, máquina de estados e pipeline de middlewares.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guara.Abstractions\Guara.Abstractions.csproj" />
  </ItemGroup>

  <!-- Pipeline, contexto e publicador de eventos são detalhe de implementação: quem consome
       depende dos contratos em Abstractions. Só o executor (que monta o pool de contexto), o
       hosting (que registra o publicador) e os testes enxergam por dentro. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Guara.Executor" />
    <InternalsVisibleTo Include="Guara.Hosting" />
    <InternalsVisibleTo Include="Guara.Core.Tests" />
    <InternalsVisibleTo Include="Guara.Hosting.Tests" />
    <InternalsVisibleTo Include="Guara.Engines.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

</Project>
