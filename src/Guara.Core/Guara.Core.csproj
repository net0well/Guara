<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guara.Core</PackageId>
    <Description>Núcleo do Guará: JobContext, máquina de estados e pipeline de middlewares.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guara.Abstractions\Guara.Abstractions.csproj" />
  </ItemGroup>

  <!-- JobContextPoolPolicy é detalhe de implementação: só o executor (que monta o pool) e
       os testes do próprio pacote enxergam. Fora do produto, vale o contrato público. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Guara.Executor" />
    <InternalsVisibleTo Include="Guara.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

</Project>
