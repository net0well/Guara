<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guara.Dashboard</PackageId>
    <Description>Composição do dashboard do Guará: AddGuaraDashboard()/MapGuaraDashboard() montam a API sob a rota base, servem a UI embutida e aplicam as regras de acesso fluentes (papéis, claims, IPs, login fixo com página própria) — seguro por padrão.</Description>
    <!-- Mesma exceção justificada do Guara.Dashboard.Api (docs/checklist.md item 6):
         host web opcional; o núcleo do Guará permanece AOT. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guara.Abstractions\Guara.Abstractions.csproj" />
    <ProjectReference Include="..\Guara.Configuration\Guara.Configuration.csproj" />
    <ProjectReference Include="..\Guara.Dashboard.Api\Guara.Dashboard.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <!--
    Integração com a SPA (Guara.Dashboard.Angular): o build .NET constrói a SPA quando
    há Node e embute o dist como recursos (prefixo Guara.Dashboard.Spa.*). Sem Node, um
    aviso é emitido e o dashboard serve a página placeholder. Defina SkipAngularBuild=true
    para pular (ex.: dev focado no backend). node_modules e dist ficam fora do git.
  -->
  <PropertyGroup>
    <AngularProjectDir>$(MSBuildProjectDirectory)\..\guara-dashboard-angular</AngularProjectDir>
    <AngularDist>$(AngularProjectDir)\dist\guara-dashboard-angular\browser</AngularDist>
    <SkipAngularBuild Condition="'$(SkipAngularBuild)' == ''">false</SkipAngularBuild>
  </PropertyGroup>

  <ItemGroup>
    <AngularInputs Include="$(AngularProjectDir)\src\**\*" />
    <AngularInputs Include="$(AngularProjectDir)\angular.json;$(AngularProjectDir)\package.json;$(AngularProjectDir)\package-lock.json;$(AngularProjectDir)\tsconfig.json;$(AngularProjectDir)\tsconfig.app.json" />
  </ItemGroup>

  <!--
    O projeto é multi-target, e os builds das duas TFMs rodam em paralelo sobre o MESMO
    diretório da SPA. Construir a SPA dentro do build por TFM cria uma corrida: um deles
    começa `npm ci`, que cria node_modules antes de instalar as ferramentas, e o outro vê
    o diretório existindo, pula a instalação e chama `ng` que ainda não está lá.

    Por isso a construção acontece uma única vez, no passo externo do multi-target, antes
    de as TFMs serem despachadas. Quando os builds internos chegam, o dist já está pronto
    e eles apenas o embutem.
  -->
  <Target Name="BuildAngularDashboardOnce"
          Condition="'$(TargetFramework)' == '' and '$(SkipAngularBuild)' != 'true'"
          BeforeTargets="DispatchToInnerBuilds"
          DependsOnTargets="BuildAngularDashboard" />

  <Target Name="BuildAngularDashboard"
          Condition="'$(SkipAngularBuild)' != 'true'"
          Inputs="@(AngularInputs)"
          Outputs="$(AngularDist)\index.html">
    <Exec Command="node --version" ContinueOnError="true" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_GuaraNodeExit" />
    </Exec>
    <Warning Condition="'$(_GuaraNodeExit)' != '0'"
             Text="Guara.Dashboard: Node não encontrado — a SPA não será embutida; o dashboard servirá a página placeholder. Instale Node 20.19+/22 (ou defina SkipAngularBuild=true)." />
    <Message Condition="'$(_GuaraNodeExit)' == '0'" Importance="high" Text="Guara.Dashboard: construindo a SPA Angular…" />
    <!--
      A presença de node_modules não prova instalação concluída: o npm cria o diretório
      logo no início. O binário do Angular só aparece no fim, então é ele que decide se
      há o que instalar.
    -->
    <Exec Condition="'$(_GuaraNodeExit)' == '0' and !Exists('$(AngularProjectDir)\node_modules\.bin\ng')"
          Command="npm ci" WorkingDirectory="$(AngularProjectDir)" />
    <Exec Condition="'$(_GuaraNodeExit)' == '0'"
          Command="npm run build" WorkingDirectory="$(AngularProjectDir)" />
  </Target>

  <!-- Antes de AssignTargetPaths/CreateManifestResourceNames: os itens precisam existir
       antes de o SDK congelar a lista de recursos que o compilador recebe. -->
  <Target Name="EmbedAngularDashboard"
          BeforeTargets="AssignTargetPaths;CreateManifestResourceNames"
          DependsOnTargets="BuildAngularDashboard">
    <!-- Primeiro materializa o glob; num segundo ItemGroup projeta em EmbeddedResource
         usando metadado QUALIFICADO (%(_SpaFile.Filename)) — assim o nome por arquivo
         não sofre batching contra os recursos já existentes (a logo). -->
    <ItemGroup Condition="Exists('$(AngularDist)\index.html')">
      <_SpaFile Include="$(AngularDist)\**\*" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(AngularDist)\index.html')">
      <EmbeddedResource Include="@(_SpaFile)">
        <LogicalName>Guara.Dashboard.Spa.%(_SpaFile.RecursiveDir)%(_SpaFile.Filename)%(_SpaFile.Extension)</LogicalName>
        <Visible>false</Visible>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
