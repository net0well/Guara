<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Guara.Analyzers</PackageId>
    <Description>Analisadores Roslyn do Guará: transformam as regras de dependência da arquitetura em erro de compilação — dependência invertida e motor referenciando provider concreto.</Description>
    <!-- Analisadores rodam dentro do compilador: netstandard2.0 obrigatório. -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsAotCompatible>false</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      Mesmo empacotamento do gerador: o assembly vai para analyzers/dotnet/cs e nada vai
      para lib/, o grupo de dependências é suprimido e não há pacote de símbolos, que
      sairia vazio.
    -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guara.Analyzers.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);EmpacotaAnalisadores</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="EmpacotaAnalisadores">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
