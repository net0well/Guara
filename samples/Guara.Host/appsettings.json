{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Guara": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH:mm:ss.fff'Z'"
      }
    }
  },

  "Guara": {
    "ApplicationName": "guara-host",
    "DefaultQueues": [ "default" ],

    "Dispatcher": {
      "PollingInterval": "00:00:02",
      "Queues": [ "relatorios", "emails", "default" ]
    },

    "Worker": {
      "MaxConcurrency": 8,
      "ShutdownDrainTimeout": "00:00:30"
    },

    "Retry": {
      "MaxAttempts": 3
    },

    "Server": {
      "HeartbeatInterval": "00:00:15",
      "MaintenanceInterval": "00:01:00",
      "RecurringPollInterval": "00:00:05",
      "Retention": {
        "Succeeded": "1.00:00:00",
        "Failed": "7.00:00:00"
      }
    },

    "Storage": {
      "PostgreSql": {
        "ConnectionString": "",
        "Schema": "guara",
        "AutoMigrate": true
      }
    },

    "Dashboard": {
      "BasePath": "/guara",
      "User": "admin",
      "Password": ""
    }
  }
}
