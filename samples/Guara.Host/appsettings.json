{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Guara": "Information"
    }
  },
  "AllowedHosts": "*",

  "Guara": {
    "ApplicationName": "guara",
    "DefaultQueues": [ "default" ],

    "Storage": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Port=5432;Database=guara;Username=guara;Password=guara_dev"
    },

    "Scheduler": {
      "DefaultTimeZone": "UTC"
    },

    "Dispatcher": {
      "PollingInterval": "00:00:05",
      "FetchBatchSize": 10,
      "Queues": [ "default" ],
      "MaxInFlight": 100
    },

    "Worker": {
      "MaxConcurrency": 8,
      "ShutdownDrainTimeout": "00:00:30",
      "LeaseRenewInterval": "00:02:00"
    },

    "Server": {
      "HeartbeatInterval": "00:00:15",
      "MaintenanceInterval": "00:01:00",
      "ShutdownTimeout": "00:00:30",
      "Retention": {
        "Succeeded": "1.00:00:00",
        "Failed": "7.00:00:00"
      }
    },

    "Cluster": {
      "Enabled": true,
      "LeadershipTtl": "00:00:30",
      "LeadershipRenewInterval": "00:00:10"
    },

    "Distributed": {
      "Enabled": false,
      "Transport": "StorageNative"
    },

    "Dashboard": {
      "BasePath": "/guara",
      "RequireAuthorization": true,
      "Realtime": {
        "Enabled": true,
        "Transport": "Sse",
        "HeartbeatSeconds": 15
      }
    },

    "Telemetry": {
      "Enabled": false,
      "ServiceName": "Guara",
      "Otlp": {
        "Endpoint": "http://localhost:4319",
        "Protocol": "Grpc"
      }
    }
  },

  "Authentication": {
    "Jwt": {
      "Key": "CHANGE_ME__64_HEX_SECRET__set_via_env_or_user-secrets",
      "Issuer": "Guara",
      "Audience": "Guara",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 7,
      "PasswordResetTokenHours": 1
    },
    "Dashboard": {
      "BasicAuthUser": "guara_admin",
      "BasicAuthPassword": "CHANGE_ME"
    }
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5342" } }
    ]
  }
}
