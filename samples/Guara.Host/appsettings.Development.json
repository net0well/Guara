{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Guara": "Debug"
    }
  },

  "Guara": {
    "Storage": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Port=5435;Database=guara;Username=guara;Password=guara_dev"
    },
    "Dashboard": {
      "RequireAuthorization": false
    },
    "Telemetry": {
      "Enabled": false
    }
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5342" } }
    ]
  }
}
