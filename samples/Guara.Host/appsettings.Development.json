{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Guara": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "IncludeScopes": true }
    }
  },

  "Guara": {
    "Storage": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Port=5435;Database=guara;Username=guara;Password=guara_dev"
    },
    "Dashboard": {
      "RequireAuthorization": false
    },
    "Telemetry": {
      "Enabled": false
    }
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
